** Loop gain of OTA 1 with the fixed choppers held in one state (straight / cross).
** CH1 at the OTA input, CH2 inside the OTA between the 1st-stage output and the 2nd-stage gates (clkCh2_nd).
** Feedback network of the 1st integrator: Ci = 14 pF, Cs + Cd = 8.4 pF (beta = 0.625). Measurement: T = -(fb_p - fb_m) / (INp - INn), beta = 0.6.
** Results: ch_ota_straight.txt / ch_ota_cross.txt (f, T in dB, phase in degrees) -> results/chopper_noc/
.param mc_mm_switch=0
.param mc_pr_switch=0
.include "/foss/pdks/sky130A/libs.tech/ngspice/corners/tt.spice"
.include "/foss/pdks/sky130A/libs.tech/ngspice/r+c/res_typical__cap_typical.spice"
.include "/foss/pdks/sky130A/libs.tech/ngspice/r+c/res_typical__cap_typical__lin.spice"
.include "/foss/pdks/sky130A/libs.tech/ngspice/corners/tt/specialized_cells.spice"
.include /foss/pdks/sky130A/libs.ref/sky130_fd_sc_hd/spice/sky130_fd_sc_hd.spice
.temp 25
.param vch=1.8
R5 OUTp net1 100Meg
R6 net1 OUTn 100Meg
E1 CMFB VSS net1 CMFB_ref 200
V1 CMFB_ref 0 0.9
V2 VDD 0 1.8
I0 Ibias 0 30.8u
V3 VSS 0 0
V4 ac_p 0 dc 0 ac 1
C5 OUTp VSS 150f
C7 OUTn VSS 150f
C6 CMFB_ref fb_m 8.4p
C8 fb_m OUTp 14p
C9 fb_p OUTn 14p
C10 CMFB_ref fb_p 8.4p
C11 OUTp CMFB_ref 400f
C12 OUTn CMFB_ref 400f
Lfb OUTp INn 1G
Lfb1 INp OUTn 1G
C14 INp net4 1m
R7 fb_m CMFB_ref 1T
R8 fb_p CMFB_ref 1T
E2 net4 0 ac_p 0 0.5
C19 INn net5 1m
E3 net5 0 ac_p 0 -0.5
* chopper state: vch = 1.8 straight, 0 cross (CH1 and CH2 together)
Vch clkch 0 {vch}
Bchb clkch_b 0 V = 1.8 - v(clkch)
Vch2 clkCh2_nd 0 {vch}
x1 VDD Ibias ota_n OUTp OUTn ota_p VSS CMFB clkCh2_nd FullyDiffOTA
x2 clkch VDD clkch_b VSS ota_n INn ota_p INp chopper

.control
  set wr_singlescale
  option numdgt=7
  foreach st 1.8 0
    alterparam vch = $st
    reset
    op
    print v(OUTp) v(OUTn) v(ota_p) v(ota_n) v(clkch) v(x1.clkCh2) v(x1.clkCh2_b)
    print v(x1.OUTp1) v(x1.OUTn1) v(x1.ChOUTp1) v(x1.ChOUTn1) i(V2)
    ac dec 100 1 1G
    let T = -(v(fb_p)-v(fb_m))/(v(INp)-v(INn))
    let Tdb = vdb(T)
    let Tph = cph(T)*180/pi
    meas ac dc_loop_gain_db find vdb(T) at=10
    meas ac f_u_loop when vmag(T)=1
    meas ac ph_u find vp(T) when vmag(T)=1
    wrdata /foss/designs/ch_ota_vch{$st}.txt Tdb Tph
  end
.endc

