*.iopin Seed
*.iopin VSS
*.iopin clk_nd
*.iopin clk
*.iopin clk_b
*.iopin VDD
x1 net1 clk_b VSS VSS VDD VDD net2 sky130_fd_sc_hd__nor2_1
x37 Seed clk_nd VSS VSS VDD VDD net1 sky130_fd_sc_hd__nand2_1
x33 clk clk_nd VSS VSS VDD VDD net5 sky130_fd_sc_hd__nor2_1
x38 net8 VSS VSS VDD VDD clk sky130_fd_sc_hd__inv_4
x40 net5 VSS VSS VDD VDD net6 sky130_fd_sc_hd__inv_1
x2 net9 VSS VSS VDD VDD clk_b sky130_fd_sc_hd__inv_4
x3 net2 VSS VSS VDD VDD net3 sky130_fd_sc_hd__inv_1
x4 net3 VSS VSS VDD VDD net4 sky130_fd_sc_hd__inv_1
x5 net4 VSS VSS VDD VDD net8 sky130_fd_sc_hd__inv_1
x6 net7 VSS VSS VDD VDD net9 sky130_fd_sc_hd__inv_1
x7 net6 VSS VSS VDD VDD net7 sky130_fd_sc_hd__inv_1
.ends


* expanding   symbol:  Analog/TG_switch.sym # of pins=6
